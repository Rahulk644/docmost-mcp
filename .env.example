DOCMOST_BASE_URL=https://docs.example.com

# Choose one Docmost authentication mode.
# DOCMOST_API_TOKEN=
# DOCMOST_EMAIL=mcp-service-account@example.com
# DOCMOST_PASSWORD=

# Generate with: openssl rand -hex 32
DOCMOST_MCP_BEARER_TOKEN=

# Remote multi-user mode: users authorize with their own Docmost accounts.
DOCMOST_MCP_ACCOUNT_AUTH=false
# DOCMOST_MCP_PUBLIC_URL=https://mcp.example.com

DOCMOST_MCP_ENABLE_WRITES=false
